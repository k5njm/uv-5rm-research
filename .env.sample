# Personal settings for this radio. Copy to .env (git-ignored) and fill in; nothing here is committed.
#   scripts/dev.sh personalize      builds build-out/personal/boot-logo.rgb565 (+ .png preview) from these values
OWNER_CALLSIGN=N0CALL
OWNER_NAME=Your Name
RADIO_MODEL=UV-5RM
# The text the radio shows when you hold 8 while powering on
RADIO_BOARD=5RHNRFB-YP07
# Start-up tune for set_boot_tune.py: doom, mario, or none
BOOT_TUNE=doom
# Serial port of the programming cable (ls /dev/cu.usbserial*)
RADIO_PORT=/dev/cu.usbserial-XXXX
