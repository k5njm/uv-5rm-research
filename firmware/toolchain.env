# Pinned toolchains (read by dev/Dockerfile via scripts/dev.sh, the CI workflow, and firmware/tools/build_core.sh).
# SMALL_TOOLCHAIN builds the shipped core and apps: nightly, panic=immediate-abort, core rebuilt for size
#   (core 61,352 -> 57,820 bytes; see docs/CORE-FIRMWARE-BUDGET.md). Pin an exact date: the flags changed this season.
# LEGACY_TOOLCHAIN is stable; it exists so the shipped binaries (built with it) can still be reproduced for the
#   provenance check, and for the host simulator.
SMALL_TOOLCHAIN=nightly-2026-11-06
LEGACY_TOOLCHAIN=1.99.1
